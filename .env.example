# Copy to .env and replace every CHANGE_ME value. Never commit .env.
COMPOSE_PROJECT_NAME=master-mentor

# --- runtime ---
APP_ENV=development
APP_DEFAULT_TIMEZONE=Asia/Kolkata
RULESET_VERSION=v1
LOG_LEVEL=INFO

# --- MySQL (container) ---
MYSQL_DATABASE=mastermentor
MYSQL_USER=mastermentor_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- host port bindings (always 127.0.0.1) ---
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- backups (nightly at BACKUP_HOUR_UTC; files owned by HOST_UID:HOST_GID) ---
HOST_UID=1000
HOST_GID=1000
BACKUP_HOUR_UTC=21
BACKUP_RETENTION_DAYS=14

# --- backend connection pool ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
